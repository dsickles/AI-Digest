{
  "name": "dans-digest",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "validate:weeks": "node scripts/validate-weeks.mjs",
    "validate:weeks:self-test": "node scripts/validate-weeks.mjs --self-test",
    "check:reader": "node scripts/check-reader.mjs",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test:unit": "vitest run tests/unit",
    "test:site": "vitest run tests/site",
    "test": "pnpm test:unit && pnpm build && pnpm test:site"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
