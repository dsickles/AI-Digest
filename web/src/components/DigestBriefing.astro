---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import CategorySection from './CategorySection.astro';
import { TOPICS } from '../lib/topics';

interface Props {
  digest: CollectionEntry<'digests'>;
}

const { digest } = Astro.props;
const { data } = digest;
const topN = data.briefing_top_n.length;
const briefingHeader = `Briefing — Top ${topN} this week`;
---

{
  data.weekly_synthesis.text && (
    <section class="weekly-synthesis mb-6">
      <p class="m-0 text-base leading-normal text-[hsl(216_12%_81%)]">
        {data.weekly_synthesis.text}
      </p>
    </section>
  )
}

<section class="briefing mb-8">
  <h2 class="briefing-header mb-4 mt-0 text-[1.375rem] font-semibold leading-tight text-foreground">
    {briefingHeader}
  </h2>
  <ol class="briefing-list m-0 list-decimal pl-6 marker:font-semibold">
    {
      data.briefing_top_n.map((card) => (
        <li class="briefing-item mb-4 pl-1">
          <Card card={card} briefing />
        </li>
      ))
    }
  </ol>
</section>

{
  TOPICS.map((topic) => (
    <CategorySection topic={topic} section={data.category_sections[topic]} />
  ))
}
