---
interface PipelineNotesData {
  show?: boolean;
  summary_line: string;
  details?: string[];
}

interface Props {
  pipelineNotes?: PipelineNotesData | null;
}

const { pipelineNotes } = Astro.props;
---

{
  pipelineNotes && (
    <details class="mb-6 rounded border border-border border-l-4 border-l-[#4a5260] bg-card">
      <summary class="cursor-pointer px-4 py-3 text-sm text-muted-foreground focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
        {pipelineNotes.summary_line}
      </summary>
      {pipelineNotes.details && pipelineNotes.details.length > 0 && (
        <ul class="m-0 list-disc space-y-2 px-4 pb-4 pl-8 text-sm text-muted-foreground">
          {pipelineNotes.details.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      )}
    </details>
  )
}
