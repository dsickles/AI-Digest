---
import TabBar from './TabBar.astro';
import BackToLatest from './BackToLatest.astro';
import { formatUpdated, formatWeekRange } from '../lib/formatWeekRange';

interface Props {
  weekRangeStart?: string;
  weekRangeEnd?: string;
  updatedAt?: string;
  weekPrefix?: string;
  showBackLink?: boolean;
}

const {
  weekRangeStart,
  weekRangeEnd,
  updatedAt,
  weekPrefix,
  showBackLink = false,
} = Astro.props;
const weekLabel =
  weekRangeStart && weekRangeEnd
    ? formatWeekRange(weekRangeStart, weekRangeEnd)
    : null;
const updatedLabel = updatedAt ? formatUpdated(updatedAt) : null;
---

<header class="border-b border-border px-4 pb-6 pt-8 md:px-5">
  <div class="mx-auto flex max-w-[720px] flex-col gap-2">
    <h1 class="m-0 text-[1.75rem] font-semibold leading-tight text-foreground">
      AI Digest
    </h1>
    {weekLabel && <p class="m-0 text-sm text-muted-foreground">{weekLabel}</p>}
    {updatedLabel && (
      <p class="m-0 text-sm text-[hsl(220_9%_46%)]">{updatedLabel}</p>
    )}
    {showBackLink && <BackToLatest />}
    <TabBar weekPrefix={weekPrefix} />
  </div>
</header>
