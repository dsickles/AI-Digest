---
const TOPICS = [
  { slug: '', label: 'Briefing', href: '/' },
  { slug: 'edtech', label: 'Edtech', href: '/edtech' },
  { slug: 'business', label: 'Business', href: '/business' },
  { slug: 'technical', label: 'Technical', href: '/technical' },
] as const;

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') {
    return pathname === '/';
  }
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<nav
  class="flex flex-wrap gap-2 border-b border-border pb-4"
  aria-label="Digest sections"
>
  {
    TOPICS.map((tab) => (
      <a
        href={tab.href}
        class:list={[
          'inline-flex min-h-11 min-w-11 items-center justify-center rounded px-3 py-2 text-sm font-normal text-foreground no-underline hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
          isActive(tab.href) &&
            'border-b-2 border-accent font-semibold text-accent',
        ]}
        aria-current={isActive(tab.href) ? 'page' : undefined}
      >
        {tab.label}
      </a>
    ))
  }
  <a
    href="/archive"
    class:list={[
      'inline-flex min-h-11 min-w-11 items-center justify-center rounded px-3 py-2 text-sm font-normal text-foreground no-underline hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
      isActive('/archive') && 'border-b-2 border-accent font-semibold text-accent',
    ]}
    aria-current={isActive('/archive') ? 'page' : undefined}
  >
    Archive
  </a>
</nav>
