---
import type { CollectionEntry } from 'astro:content';
import { formatWeekRange } from '../lib/formatWeekRange';

interface Props {
  digests: CollectionEntry<'digests'>[];
}

const { digests } = Astro.props;
---

{
  digests.length === 0 ? (
    <div class="py-8">
      <h2 class="m-0 text-[1.375rem] font-semibold leading-tight text-foreground">
        No past digests yet
      </h2>
      <p class="mt-4 text-base leading-normal text-[hsl(216_12%_81%)]">
        The first weekly digest will appear here after the pipeline runs.
      </p>
    </div>
  ) : (
    <ul class="m-0 list-none space-y-3 p-0">
      {digests.map((digest) => {
        const { week_range } = digest.data;
        const weekLabel = formatWeekRange(week_range.start, week_range.end);
        return (
          <li>
            <a
              href={`/digest/${digest.id}`}
              class="block text-[1.375rem] font-semibold leading-tight text-foreground no-underline hover:text-accent hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              {weekLabel}
            </a>
          </li>
        );
      })}
    </ul>
  )
}
