---
import type { CollectionEntry } from 'astro:content';
import { archiveExcerpt } from '../lib/archiveExcerpt';
import { formatWeekRange } from '../lib/formatWeekRange';

interface Props {
  digests: CollectionEntry<'digests'>[];
}

const { digests } = Astro.props;
---

{
  digests.length === 0 ? (
    <div class="py-8">
      <h2 class="m-0 text-[1.375rem] font-semibold leading-tight text-foreground">
        No past digests yet
      </h2>
      <p class="mt-4 text-base leading-normal text-[hsl(216_12%_81%)]">
        The first weekly digest will appear here after the pipeline runs.
      </p>
    </div>
  ) : (
    <ul class="m-0 list-none space-y-8 p-0">
      {digests.map((digest) => {
        const { week_range, week_id } = digest.data;
        const weekLabel = formatWeekRange(week_range.start, week_range.end);
        const excerpt = archiveExcerpt(digest);
        return (
          <li class="border-b border-border pb-8 last:border-b-0">
            <h2 class="m-0 text-[1.375rem] font-semibold leading-tight text-foreground">
              {weekLabel}
            </h2>
            {excerpt && (
              <p class="mt-3 text-base leading-normal text-[hsl(216_12%_81%)]">{excerpt}</p>
            )}
            <a
              href={`/digest/${week_id}`}
              class="mt-4 inline-flex min-h-11 items-center text-base text-foreground no-underline hover:text-accent hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              Read this week
            </a>
          </li>
        );
      })}
    </ul>
  )
}
