---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import { formatBriefingHeader } from '../lib/copy';

type DigestCard = CollectionEntry<'digests'>['data']['briefing_top_n'][number];

interface Props {
  cards: DigestCard[];
}

const { cards } = Astro.props;
const topN = cards.length;
---

<section class="briefing mb-8">
  <h2 class="briefing-header mb-4 mt-0 text-[1.375rem] font-semibold leading-tight text-foreground">
    {formatBriefingHeader(topN)}
  </h2>
  <ol class="briefing-list m-0 list-decimal pl-6 marker:font-semibold">
    {
      cards.map((card) => (
        <li class="briefing-item mb-4 pl-1">
          <Card card={card} briefing />
        </li>
      ))
    }
  </ol>
</section>
