---
/**
 * Reader-confidence banner (OBS-03 + ROADMAP SC4).
 *
 * Thin Astro shell over `src/lib/copy.ts#bannerCopy` so all variant
 * logic stays in plain TypeScript (vitest-testable). The banner sits
 * directly under <Header /> on both the latest-week briefing
 * (`index.astro`) and the permalink page (`digest/[week].astro`) so a
 * reader landing on either page can tell within one screenful whether
 * the week is complete, still filling in, or hit the spend cap.
 *
 * D-24 holds at this surface: the `deferred_budget` sentinel itself
 * NEVER leaks into reader copy. Only the count + plain-English
 * framing crosses the boundary.
 */
import { bannerCopy, type StatusBannerInput } from '../lib/copy';

interface Props {
  pendingTranscriptsCount?: number;
  hardCapHit?: boolean;
  deferredItemsCount?: number;
  updatedAt?: string | null;
}

const {
  pendingTranscriptsCount = 0,
  hardCapHit = false,
  deferredItemsCount = 0,
  updatedAt = null,
} = Astro.props;

const input: StatusBannerInput = {
  pendingTranscriptsCount,
  hardCapHit,
  deferredItemsCount,
  updatedAt,
};
const copy = bannerCopy(input);

// Variant-keyed border accents — complete is subtle, filling_in is
// informational, partial_cap is the loudest cue per the reader anxiety
// hierarchy documented in copy.ts.
const variantClass = {
  complete:
    'border-border bg-card text-foreground',
  filling_in:
    'border-[#3a5a7a] border-l-4 bg-[#0f1419] text-[#9ec1e6]',
  partial_cap:
    'border-[#8b6914] border-l-4 bg-[#1a1610] text-[#c8b896]',
}[copy.variant];
---

<aside
  class:list={[
    'status-banner mb-6 rounded p-4 text-base leading-normal',
    variantClass,
  ]}
  data-variant={copy.variant}
  aria-label="Digest status"
>
  <p class="m-0 font-medium">{copy.text}</p>
  {copy.lastSuccessfulRun && (
    <p class="m-0 mt-1 text-sm opacity-80">
      <time datetime={updatedAt ?? undefined}>{copy.lastSuccessfulRun}</time>
    </p>
  )}
</aside>
