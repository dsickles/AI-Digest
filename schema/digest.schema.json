{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dans-digest.local/schema/digest.schema.json",
  "title": "Dan's Digest week file",
  "description": "Pre-partitioned week file for content/digests/{week_id}.json. Briefing is synthesis plus Top 5 full cards. From 2026-W41 on, briefing also has a one-sentence lead and 4 to 6 themes. Each theme has a short label, one sentence of 25 to 35 words, and story_ids for the merged main items. Earlier weeks omit lead and themes. topics.* are the per-topic main lists. main_feed is those lists concatenated (edtech, business, technical, policy-and-safety). footer_aside is thin link-only cards. excluded holds items that failed the inclusion rubric and is not rendered. From 2026-W41 on, every card has included and include_reason. Earlier weeks may omit both. A story with several included sources is one card: also_covered lists the other sources, and number_note records a key number they disagree on. Earlier weeks omit both. There is no per-source cap. The site renders the briefing, topic, and footer lists as written, skipping any card marked included false. topics.policy-and-safety may be omitted and then counts as empty.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "week_id",
    "timezone",
    "week_start",
    "week_end",
    "generated_at",
    "briefing",
    "topics",
    "main_feed",
    "footer_aside"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "week_id": {
      "description": "ISO week of the ending Saturday, the Saturday that closes the America/New_York window.",
      "type": "string",
      "pattern": "^[0-9]{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$"
    },
    "timezone": {
      "const": "America/New_York"
    },
    "week_start": {
      "description": "Sunday 00:00:00 America/New_York, written with that instant's offset.",
      "type": "string",
      "format": "date-time"
    },
    "week_end": {
      "description": "Saturday 23:59:59 America/New_York, written with that instant's offset.",
      "type": "string",
      "format": "date-time"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "briefing": {
      "$ref": "#/$defs/briefing"
    },
    "topics": {
      "$ref": "#/$defs/topics"
    },
    "main_feed": {
      "description": "In-place cards only: ok summaries and degraded cards. Must equal topics.edtech + topics.business + topics.technical + topics.policy-and-safety. A missing policy-and-safety list counts as empty.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/mainCard"
      }
    },
    "footer_aside": {
      "description": "Thin links only. No summary body. RSS articles and description-only videos both belong here.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/thinCard"
      }
    },
    "excluded": {
      "description": "Items that failed the inclusion rubric. Not rendered. Required from 2026-W41 on, including when the list is empty. Earlier weeks omit it.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/excludedCard"
      }
    }
  },
  "$defs": {
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "sentence", "story_ids"],
      "properties": {
        "label": {
          "description": "Short label, at most 4 words, not a sentence.",
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "sentence": {
          "description": "One sentence of 25 to 35 words. The word count is checked by validate:weeks.",
          "type": "string",
          "minLength": 1
        },
        "story_ids": {
          "description": "Item ids of the merged main items for this theme. One id per story. Do not list two copies.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "name"],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mainCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url",
        "publisher",
        "published_at",
        "category",
        "media",
        "summary_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "publisher": {
          "$ref": "#/$defs/publisher"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "category": {
          "enum": ["edtech", "business", "technical", "policy-and-safety"]
        },
        "media": {
          "enum": ["article", "video"]
        },
        "summary_status": {
          "description": "ok is a full card. Every other value is an in-place degraded card. thin is not a main-list status.",
          "enum": [
            "ok",
            "quota_exhausted",
            "api_error",
            "parse_error",
            "client_init_error",
            "transcript_missing",
            "deferred_budget"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "const": "The summary couldn't be generated this week."
        },
        "included": {
          "description": "False means the item failed the rubric. Omitted on weeks before 2026-W41.",
          "type": "boolean"
        },
        "include_reason": {
          "$ref": "#/$defs/includeReason"
        },
        "also_covered": {
          "$ref": "#/$defs/alsoCovered"
        },
        "number_note": {
          "$ref": "#/$defs/numberNote"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["summary_status"],
            "properties": {
              "summary_status": { "const": "ok" }
            }
          },
          "then": {
            "required": ["summary"],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "body": false
            }
          },
          "else": {
            "required": ["body"],
            "properties": {
              "summary": false,
              "body": {
                "const": "The summary couldn't be generated this week."
              }
            }
          }
        }
      ]
    },
    "fullCard": {
      "allOf": [
        { "$ref": "#/$defs/mainCard" },
        {
          "type": "object",
          "required": ["summary_status"],
          "properties": {
            "summary_status": { "const": "ok" }
          }
        }
      ]
    },
    "thinCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url",
        "publisher",
        "published_at",
        "category",
        "media",
        "summary_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "publisher": {
          "$ref": "#/$defs/publisher"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "category": {
          "enum": ["edtech", "business", "technical", "policy-and-safety"]
        },
        "media": {
          "description": "article for a thin feed link. video when the summary was written only from a video description.",
          "enum": ["article", "video"]
        },
        "summary_status": {
          "const": "thin"
        },
        "included": {
          "type": "boolean"
        },
        "include_reason": {
          "$ref": "#/$defs/includeReason"
        },
        "also_covered": {
          "$ref": "#/$defs/alsoCovered"
        },
        "number_note": {
          "$ref": "#/$defs/numberNote"
        }
      }
    },
    "coverageLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "publisher"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "publisher": {
          "$ref": "#/$defs/publisher"
        }
      }
    },
    "alsoCovered": {
      "description": "Other included sources for this same story. The card is the strongest source. Omit when the story has one source. Weeks before 2026-W41 omit it.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/coverageLink"
      }
    },
    "numberNote": {
      "description": "One line naming a key number each source reported, when those numbers disagree. Example: 722 per Education Disrupted, 719 per Last Week in AI.",
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
    },
    "includeReason": {
      "description": "One line saying why the item was included or excluded.",
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
    },
    "excludedCard": {
      "allOf": [
        {
          "oneOf": [
            { "$ref": "#/$defs/mainCard" },
            { "$ref": "#/$defs/thinCard" }
          ]
        },
        {
          "type": "object",
          "required": ["included", "include_reason"],
          "properties": {
            "included": { "const": false },
            "include_reason": { "$ref": "#/$defs/includeReason" }
          }
        }
      ]
    },
    "briefing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthesis", "top"],
      "properties": {
        "synthesis": {
          "type": "string",
          "minLength": 1
        },
        "lead": {
          "description": "One sentence. Required from 2026-W41 on, together with themes. Earlier weeks omit it.",
          "type": "string",
          "minLength": 1
        },
        "themes": {
          "description": "Four to six theme rows. Required from 2026-W41 on, together with lead. Each sentence is 25 to 35 words. story_ids are merged main item ids.",
          "type": "array",
          "minItems": 4,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/theme"
          }
        },
        "top": {
          "description": "Briefing Top N. N is 5. Full cards only, not every card in the week.",
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/fullCard"
          }
        }
      }
    },
    "topics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edtech", "business", "technical"],
      "properties": {
        "edtech": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/mainCard" },
              {
                "type": "object",
                "required": ["category"],
                "properties": { "category": { "const": "edtech" } }
              }
            ]
          }
        },
        "business": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/mainCard" },
              {
                "type": "object",
                "required": ["category"],
                "properties": { "category": { "const": "business" } }
              }
            ]
          }
        },
        "technical": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/mainCard" },
              {
                "type": "object",
                "required": ["category"],
                "properties": { "category": { "const": "technical" } }
              }
            ]
          }
        },
        "policy-and-safety": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/mainCard" },
              {
                "type": "object",
                "required": ["category"],
                "properties": { "category": { "const": "policy-and-safety" } }
              }
            ]
          }
        }
      }
    }
  }
}
