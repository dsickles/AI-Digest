# Secrets — never commit (D-B8 layer 2)
.env
.env.local
*.pem
*.key

# Working data (gitignored per ARCHITECTURE store-and-forward)
data/
data/*.db

# Generated digest output (Phase 1 plain HTML; archive JSON moves to git in Phase 4)
out/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/

# uv
# uv.lock IS committed for reproducibility — do not gitignore it.

# Web / Astro build artifacts (committed archive lives under web/src/content/)
web/node_modules/
web/.astro/
web/dist/

# Operator-local tool binaries (e.g. actionlint downloaded via the
# official install script — operators may also use `brew install actionlint`).
.tools/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
