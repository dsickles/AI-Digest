---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { parse as parseYaml } from 'yaml';
import AboutTabs from '../../components/AboutTabs.astro';
import Shell from '../../components/Shell.astro';
import { countSourceReferences, loadSourceIndex, sourceWeekCountLabel } from '../../lib/sources.mjs';
import { formatSourceCountSubline, latestWeek, synthesisExcerpt } from '../../lib/weeks';

interface SourceIndexRow {
  id: string;
  homeUrl: string;
  name: string;
  typeLabel: string;
}

const week = latestWeek();
const index = loadSourceIndex();
const sourceFile = parseYaml(readFileSync(join(process.cwd(), 'config', 'sources.yaml'), 'utf8'));
const references = countSourceReferences(week, sourceFile?.sources ?? []);
const subline = week ? formatSourceCountSubline(week.week_start, week.week_end) : '';
---

<Shell
  title="About: sources · Dan's AI Digest"
  description={week ? synthesisExcerpt(week.briefing.synthesis) : undefined}
  canonical="/about/sources"
  week={week}
  active="about"
  scope="latest"
>
  <AboutTabs tab="sources" />
  <header class="sources-head">
    <h2 class="page-title">Sources <span class="tot">({index.total})</span></h2>
    {subline && <p class="sources-note">{subline}</p>}
  </header>
  <div class="source-cols">
    {
      index.sections.map((section) => (
        <section
          class="source-section"
          data-section={section.id}
          aria-labelledby={`source-section-${section.id}`}
        >
          <h2 class="source-section-title" id={`source-section-${section.id}`}>
            {section.label}<span class="n">{section.count}</span>
          </h2>
          <ul class="source-list">
            {section.sources.map((source: SourceIndexRow) => {
              const count = references.get(source.id) ?? 0;
              return (
                <li class="source-row">
                  <a href={source.homeUrl} target="_blank" rel="noopener noreferrer">
                    {source.name}
                  </a>
                  <span class="source-type">{source.typeLabel}</span>
                  <span class:list={['source-count', count === 0 && 'none']}>{sourceWeekCountLabel(count)}</span>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</Shell>
