---
import Shell from '../../../components/Shell.astro';
import WeekBody from '../../../components/WeekBody.astro';
import { latestWeek, loadWeeks, synthesisExcerpt, type Week } from '../../../lib/weeks';

export function getStaticPaths() {
  return loadWeeks().map((week) => ({
    params: { week: week.week_id },
    props: { week },
  }));
}

interface Props {
  week: Week;
}

const { week } = Astro.props;
const latest = latestWeek();
---

<Shell
  description={synthesisExcerpt(week.briefing.synthesis)}
  week={week}
  active="briefing"
  scope="week"
  showLatestLink={latest?.week_id !== week.week_id}
>
  <WeekBody week={week} view="briefing" />
</Shell>
