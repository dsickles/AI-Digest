---
import CoverageNotes from './CoverageNotes.astro';
import PlayIcon from './PlayIcon.astro';
import { formatDate, type MainCard } from '../lib/weeks';

interface Props {
  card: MainCard;
  variant?: 'top' | 'topic';
  index?: number;
}

const { card, variant = 'top', index } = Astro.props;
const video = card.media === 'video';
const summary = card.summary_status === 'ok' ? card.summary : card.body;
const summaryId = `summary-${card.id}`;
---

<article class="card" id={card.id}>
  {variant === 'top' && index !== undefined && <span class="num" aria-hidden="true">{index}</span>}
  <div class="main">
    <h3 class="card-title">
      <a href={card.url} target="_blank" rel="noopener noreferrer">{card.title}</a>
    </h3>
    <p class="meta">
      <span class="publisher">{card.publisher.name}</span>
      {
        video && (
          <>
            <PlayIcon />
            <span class="visually-hidden">Video</span>
          </>
        )
      }
      <span class="sep" aria-hidden="true">·</span>
      <time datetime={card.published_at}>{formatDate(card.published_at)}</time>
    </p>
    <CoverageNotes links={card.also_covered} numberNote={card.number_note} />
  </div>
  {
    variant === 'topic' ? (
      <>
        <button class="toggle" type="button" aria-expanded="false" aria-controls={summaryId}>
          Summary
          <svg viewBox="0 0 10 10" aria-hidden="true" focusable="false">
            <path
              d="M1.75 3.25 5 6.75 8.25 3.25"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <div class="summary-panel" id={summaryId}>
          <p class="summary">{summary}</p>
        </div>
      </>
    ) : (
      <p class="summary">{summary}</p>
    )
  }
</article>
