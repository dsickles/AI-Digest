---
import { latestPath, shownTopicCards, weekPath, TOPIC_LABELS, type Topic, type Week } from '../lib/weeks';

interface Props {
  active: 'briefing' | Topic | 'archive' | 'sources';
  scope: 'latest' | 'week';
  week?: Week;
}

const { active, scope, week } = Astro.props;

// Visible order only. Topic ids and routes stay on the canonical list.
const sections: Topic[] = ['business', 'technical', 'edtech', 'policy-and-safety'];

function hrefFor(view: 'briefing' | Topic): string {
  if (scope === 'week' && week) return weekPath(week.week_id, view);
  return latestPath(view);
}

function storyCount(topic: Topic): number {
  if (!week) return 0;
  return shownTopicCards(week, topic).length;
}
---

<nav class="nav nav-briefing" aria-label="Briefing">
  <a href={hrefFor('briefing')} aria-current={active === 'briefing' ? 'page' : undefined}>Briefing</a>
</nav>
<nav class="nav nav-sections" aria-label="Sections">
  {
    sections.map((topic) => {
      const count = storyCount(topic);
      const label = TOPIC_LABELS[topic];
      return (
        <a
          href={hrefFor(topic)}
          aria-current={active === topic ? 'page' : undefined}
          aria-label={`${label} ${count}`}
          class={count === 0 ? 'zero' : undefined}
        >
          {label}
          <span class="n">{count}</span>
        </a>
      );
    })
  }
</nav>
