---
import type { CoverageLink } from '../lib/weeks';

interface Props {
  links?: CoverageLink[];
  numberNote?: string;
}

const links = Astro.props.links ?? [];
const numberNote = Astro.props.numberNote;

function separator(index: number, count: number): string {
  if (index === 0) return '';
  if (index === count - 1) return count === 2 ? ' and ' : ', and ';
  return ', ';
}
---

{
  numberNote && <p class="number-note">{numberNote}</p>
}
{
  links.length > 0 && (
    <p class="also-covered">
      Also covered by{' '}
      {links.map((link, index) => (
        <span>
          {separator(index, links.length)}
          <a href={link.url} title={link.title} target="_blank" rel="noopener noreferrer">
            {link.publisher.name}
          </a>
        </span>
      ))}
    </p>
  )
}
