---
import Card from './Card.astro';
import ThinCard from './ThinCard.astro';
import type { MainCard, ThinCard as ThinItem } from '../lib/weeks';

interface Props {
  label: string;
  cards: MainCard[];
  alsoSeen?: ThinItem[];
}

const { label, cards, alsoSeen = [] } = Astro.props;
const mid = Math.ceil(cards.length / 2);
const columns = cards.length <= 1 ? [cards] : [cards.slice(0, mid), cards.slice(mid)];
---

<section class="g topic" aria-labelledby="topic-heading">
  <h2 class="page-title" id="topic-heading">{label}</h2>
  {
    cards.length === 0 ? (
      <p class="empty">Nothing in {label} this week.</p>
    ) : (
      <div class="rowsets">
        {columns.map((column, columnIndex) => {
          const start = columnIndex === 0 ? 1 : mid + 1;
          return (
            <ol class="rows" start={start} style={`counter-reset: topic-rank ${start - 1}`}>
              {column.map((card) => (
                <li class="row">
                  <Card card={card} variant="topic" />
                </li>
              ))}
            </ol>
          );
        })}
      </div>
    )
  }
  {
    alsoSeen.length > 0 && (
      <aside id="also-seen" class="also" aria-labelledby="also-heading">
        <h2 class="also-label" id="also-heading">
          Also seen
        </h2>
        <ul class="thin-list">
          {alsoSeen.map((item) => (
            <li class="thin-row">
              <ThinCard item={item} />
            </li>
          ))}
        </ul>
      </aside>
    )
  }
</section>

<script>
  const buttons = document.querySelectorAll('.toggle');
  for (const button of buttons) {
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', open ? 'true' : 'false');
      button.closest('.row')?.classList.toggle('open', open);
    });
  }
</script>
