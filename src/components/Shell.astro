---
import Base from '../layouts/Base.astro';
import SiteNav from './SiteNav.astro';
import { documentTitle, SITE_TITLE } from '../lib/site';
import { loadSourceIndex } from '../lib/sources.mjs';
import { formatDate, formatWeekRange, type Topic, type Week } from '../lib/weeks';

interface Props {
  titleParts?: string[];
  description?: string;
  canonical?: string;
  week?: Week;
  active: 'briefing' | Topic | 'archive' | 'sources';
  scope: 'latest' | 'week';
  showLatestLink?: boolean;
}

const { titleParts = [], description, canonical, week, active, scope, showLatestLink = false } = Astro.props;
const title = documentTitle(...titleParts);
const archiveCurrent = active === 'archive' ? 'page' : undefined;
const sourcesCurrent = active === 'sources' ? 'page' : undefined;
const sourceCount = loadSourceIndex().total;
---

<Base title={title} description={description} canonical={canonical}>
  <header class="g">
    <h1 class="mast"><a href="/">{SITE_TITLE}</a></h1>
    <p class="bar week-line">
      {
        week && (
          <span class="week-range">{formatWeekRange(week.week_start, week.week_end)}</span>
        )
      }
      <span class="right">
        {
          week && (
            <>
              <time datetime={week.generated_at}>Updated {formatDate(week.generated_at)}</time>
              <span class="sep" aria-hidden="true">·</span>
            </>
          )
        }
        <a href="/sources" aria-current={sourcesCurrent}>Sources</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/archive" aria-current={archiveCurrent}>Archive</a>
      </span>
    </p>
    {
      showLatestLink && (
        <p class="back">
          <a href="/">← Latest week</a>
        </p>
      )
    }
    <SiteNav active={active} scope={scope} week={week} />
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-foot">
    <a href="/sources">Every source we read ({sourceCount})</a>
  </footer>
</Base>
