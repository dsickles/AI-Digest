# Phase 5 home-worker runtime configuration template.
#
# Copy this file to a host-mounted `.env` outside the cloned repo
# (recommended: `~/aidigest/.env`, `chmod 600`). The container mounts it
# read-only at runtime — see `worker/README.md` for setup.
#
# All values below are placeholders. Never commit a real key. The
# project's leak-recovery runbook is `.planning/runbooks/leak-recovery.md`.

# --- LLM provider key -------------------------------------------------------
# Used by `pipeline.summarize` and the worker's `--only-pending-transcripts`
# pass. Cloud-side uses the same name via GitHub repo secrets.
GEMINI_API_KEY=your-key-here

# --- Object-storage credentials --------------------------------------------
# Read by `rclone` for the shared SQLite + marker bucket. Two-token model:
# the key id identifies the application key, the application key is the
# secret. Configure in your object-storage provider's console; scope to a
# single bucket where possible.
B2_KEY_ID=your-key-id-here
B2_APPLICATION_KEY=your-application-key-here

# Bucket and remote name read by `worker/rclone.conf` at runtime.
# Bucket name is not committed anywhere in the repo (Privacy Sweep).
B2_BUCKET=your-bucket-name-here
B2_REMOTE_NAME=remote

# --- GitHub push credentials -----------------------------------------------
# Fine-grained PAT scoped to one repo with `contents:write` permission only
# (D-B8 layer 1). Rotate annually using the GitHub expiration email.
GITHUB_TOKEN=your-fine-grained-pat-here
GITHUB_REPO=your-org/your-repo
GITHUB_COMMIT_AUTHOR_NAME=ai-digest-worker
GITHUB_COMMIT_AUTHOR_EMAIL=noreply@example.invalid

# --- Heartbeat ping URLs (D-B7) --------------------------------------------
# Three separate checks: weekly cron, weekly worker, weekly sentinel. Each
# expects a `/start` ping at run start and a finish ping with the payload.
HEALTHCHECK_CRON_URL=your-healthchecks-ping-url-here
HEALTHCHECK_WORKER_URL=your-healthchecks-ping-url-here
HEALTHCHECK_SENTINEL_URL=your-healthchecks-ping-url-here

# --- Optional ---------------------------------------------------------------
# Polling cadence for the home worker (seconds). Default 600 = 10 min.
WORKER_POLL_INTERVAL_SECONDS=600
